# ─── NEXUS — Variables d'environnement ───────────────────────────────────────
# Copier ce fichier en .env.local pour développer en local.
# Ne jamais committer .env.local (déjà dans .gitignore).
# En production, définir ces variables dans Vercel → Settings → Environment Variables.

# ── Base de données (Neon PostgreSQL) ─────────────────────────────────────────
# Obtenir sur https://console.neon.tech → votre projet → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require

# ── IA : génération de contenu & coaching ─────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI (fallback, génération de fiches) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Synthèse vocale (Azure Cognitive Services) ────────────────────────────────
# Créer une ressource "Speech" sur https://portal.azure.com
AZURE_TTS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TTS_REGION=francecentral

# ── Stockage fichiers (Vercel Blob) ───────────────────────────────────────────
# Vercel Dashboard → Storage → Blob → votre store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Opportunités professionnelles (Adzuna Job Search API) ─────────────────────
# Créer un compte sur https://developer.adzuna.com
ADZUNA_APP_ID=xxxxxxxx
ADZUNA_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sécurité crons & admin ────────────────────────────────────────────────────
# Secret arbitraire (ex : openssl rand -hex 32) pour protéger les routes /api/cron/*
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Code PIN à 6 chiffres pour l'écran d'administration (optionnel)
NEXT_PUBLIC_ADMIN_PIN=123456

# ── Notifications push (Firebase Cloud Messaging) ─────────────────────────────
# Ces variables ne sont PAS des variables Next.js — elles s'utilisent côté Android :
# → Télécharger google-services.json depuis https://console.firebase.google.com
#   (Votre projet → Paramètres → Vos applications → Android → google-services.json)
#   et le placer dans android/app/google-services.json (jamais committer ce fichier).

# ── Paiements in-app (RevenueCat) ────────────────────────────────────────────
# Créer un projet sur https://app.revenuecat.com
# Récupérer la clé publique Android : App settings → API Keys → Public SDK key
# Renseigner la clé dans src/lib/billing.ts (constante REVENUECAT_API_KEY)
# NB : cette clé est publique et peut être incluse dans le code natif.
